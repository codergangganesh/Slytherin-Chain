# ═══════════════════════════════════════════════════════════════════════════════
# SentinelChain — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
# Application environment: development | staging | production
APP_ENV=development

# Secret key for JWT signing. CHANGE THIS in production.
SECRET_KEY=sentinelchain-dev-secret-change-in-production

# JWT token lifetimes (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelchain
POSTGRES_USER=sentinelchain
POSTGRES_PASSWORD=sentinelchain_dev_password

# Full database URL (constructed from above, or override directly)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Redis Stream names
REDIS_STREAM_EVENTS=events.normalized
REDIS_CONSUMER_GROUP=detection_workers

# ─── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sentinelchain
MINIO_SECRET_KEY=sentinelchain_dev_password
MINIO_BUCKET_EVIDENCE=evidence
MINIO_BUCKET_REPORTS=reports
MINIO_USE_SSL=false

# ─── Blockchain / Integrity Anchoring ─────────────────────────────────────────
# RPC URL for the blockchain node (local Anvil or Sepolia)
ANCHOR_CHAIN_RPC_URL=http://anvil:8545

# Chain ID (31337 for Anvil, 11155111 for Sepolia)
ANCHOR_CHAIN_ID=31337

# Contract address (auto-set on Anvil deployment; set manually for Sepolia)
ANCHOR_CONTRACT_ADDRESS=

# Wallet private key for anchoring transactions (TESTNET ONLY — never use a mainnet key)
# Default: Anvil's first pre-funded account
ANCHOR_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Number of confirmations to wait before marking anchor as confirmed
ANCHOR_CONFIRMATIONS=1

# Interval (seconds) between Merkle anchor batches
ANCHOR_INTERVAL_SECONDS=300

# ─── Autonomous Response ──────────────────────────────────────────────────────
# Default autonomy mode: off | recommend_only | approval_required | auto
DEFAULT_AUTONOMY_MODE=auto

# Real enforcement is OFF by default. Set to true ONLY for real Linux nftables.
ENABLE_REAL_ENFORCEMENT=false

# Blast-radius rate limits (max automatic actions per hour)
MAX_AUTO_ACTIONS_PER_HOUR_GLOBAL=50
MAX_AUTO_ACTIONS_PER_HOUR_PER_TARGET_TYPE=20

# Allowlisted IPs/CIDRs that must never be blocked (comma-separated)
ALLOWLISTED_IPS=10.0.0.1,192.168.1.1,172.16.0.1

# ─── Enrichment ───────────────────────────────────────────────────────────────
# AbuseIPDB API key (optional; offline intel is used when unset)
ABUSEIPDB_API_KEY=

# Threat intel cache TTL (seconds)
THREAT_INTEL_CACHE_TTL_SECONDS=3600

# ─── Risk Scoring Weights ────────────────────────────────────────────────────
RISK_WEIGHT_SEVERITY=0.30
RISK_WEIGHT_CONFIDENCE=0.20
RISK_WEIGHT_ASSET=0.25
RISK_WEIGHT_EXPOSURE=0.10
RISK_WEIGHT_INTEL=0.15

# ─── Detection ────────────────────────────────────────────────────────────────
# Incident correlation window (seconds)
CORRELATION_WINDOW_SECONDS=1800

# ─── Reporting ────────────────────────────────────────────────────────────────
# Enable optional LLM-generated executive summary (provider-agnostic)
ENABLE_LLM_SUMMARY=false

# LLM provider configuration (only used when ENABLE_LLM_SUMMARY=true)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── Notifications (SHOULD) ──────────────────────────────────────────────────
# Webhook URL for notifications (Slack/Teams/email mock)
NOTIFICATION_WEBHOOK_URL=

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Maximum events per batch request
MAX_BATCH_SIZE=500

# API key for event ingestion (hashed in DB; this is the plaintext for seeding)
INGESTION_API_KEY=sentinelchain-demo-api-key

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
